# Copy this file to .env and fill in your key.
# Only required for live runs; `--dry-run` needs no key at all.

OPENAI_API_KEY=sk-...

# --- Optional overrides (defaults shown) ---
# ANSWER_MODEL=gpt-6-luna
# REVIEW_MODEL=gpt-6-luna
# JUDGE_MODEL=gpt-6.1-sol
# REASONING_EFFORT=low
# MAX_OUTPUT_TOKENS=2048
# CALL_TIMEOUT_SECONDS=60
# CALL_ATTEMPTS=3
# RUN_DEADLINE_SECONDS=120
# RUN_BUDGET_USD=0.50

# Embeddings: "sentence-transformers" (default) or "hashing" (offline, no download)
# EMBEDDING_BACKEND=sentence-transformers
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HASHING_DIM=512

# Retrieval / chunking
# CHUNK_SIZE=1100
# CHUNK_OVERLAP=150
# TOP_K=5
# MAX_ROUNDS=3

# Storage
# INDEX_DIR=data/index
# RAW_DIR=data/raw

# Web service
# WEB_API_KEY=
# Comma-separated 'name:key' pairs for scoped access, e.g. "alice:sk-a,bob:sk-b"
# WEB_API_KEYS=
# Comma-separated allowed browser origins for the frontend, or "*" (default)
# CORS_ORIGINS=*
# Max /research calls per minute per caller (by API key or IP). 0 disables it.
# RATE_LIMIT_PER_MINUTE=20
# Hard wall-clock cap (seconds) on a single /research call before a 504.
# REQUEST_TIMEOUT_SECONDS=120
